{
  "name": "metor",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-first realtime AI assistant (Phase 1 foundation)",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:server": "node --env-file-if-exists=.env --watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . && pnpm typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "hash-passphrase": "node scripts/hash-passphrase.ts",
    "eval:answers": "node --env-file-if-exists=.env scripts/eval-answers.ts"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
