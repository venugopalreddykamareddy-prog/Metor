# Copy to .env and fill in values. Never commit .env.
# All keys are SERVER-SIDE ONLY. Never expose them to client code (no VITE_ prefix).

# --- Server ---
PORT=8787
NODE_ENV=development
# Comma-separated list of allowed browser origins (Codespaces forwarded URL in dev)
ALLOWED_ORIGINS=http://localhost:5173

# --- Authentication (required before any real provider key is used) ---
# scrypt hash of your passphrase; generate with `pnpm hash-passphrase` (added in Phase 2)
APP_PASSPHRASE_HASH=

# --- AI provider (provider and model IDs verified in Phase 3/4) ---
OPENAI_API_KEY=
# TODO(verify): set from official provider docs in Phase 3
TRANSCRIPTION_MODEL=
# TODO(verify): set from official provider docs in Phase 4
ANSWER_MODEL=

# --- Spending and safety limits ---
# Max answer requests per session
MAX_ANSWERS_PER_SESSION=100
# Max transcription minutes per session
MAX_TRANSCRIPTION_MINUTES=90
# Daily spend ceiling in USD, enforced server-side from estimates (persisted ledger).
# Also set a budget in the provider console as the hard backstop.
DAILY_SPEND_LIMIT_USD=5
SPEND_LEDGER_PATH=./data/spend-ledger.json
