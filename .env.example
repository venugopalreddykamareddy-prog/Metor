# Copy to .env and fill in values. Never commit .env.
# In Codespaces, prefer Codespaces secrets over a .env file.
# All keys are SERVER-SIDE ONLY. Never expose them to client code (no VITE_ prefix).

# --- Server ---
PORT=8787
NODE_ENV=development
# Comma-separated list of allowed browser origins (Codespaces forwarded URL in dev)
ALLOWED_ORIGINS=http://localhost:5173

# --- Authentication (required; the server won't start without it) ---
# scrypt hash of your login passphrase. Generate it with:
#   read -rs P && printf %s "$P" | pnpm -s hash-passphrase; unset P
APP_PASSPHRASE_HASH=

# --- Providers (free-first; see docs/DECISIONS.md ADR-009 and ADR-011) ---
# Transcription mode is picked per recording in the UI (Simulated, Browser speech, Groq Whisper).
# Groq is offered only when GROQ_API_KEY is set.
# Answers (Phase 4): simulated | groq | gemini. Only simulated works today.
ANSWER_PROVIDER=simulated
# Paid providers are disabled. Never fall back to a paid provider automatically.
# None are implemented in the MVP; enabling one requires an ADR.
ALLOW_PAID_PROVIDERS=false

# --- Groq (free tier; do NOT add a payment method; enable Zero Data Retention) ---
GROQ_API_KEY=
# whisper-large-v3-turbo (default) or whisper-large-v3; checked against Groq docs 2026-11-24
GROQ_TRANSCRIPTION_MODEL=
# TODO(verify): set from official Groq docs at the start of Phase 4
GROQ_ANSWER_MODEL=
# Optional smaller model for classification/summaries; empty = use GROQ_ANSWER_MODEL
GROQ_CLASSIFY_MODEL=

# --- Gemini (optional free tier; do NOT enable billing on the project) ---
# Free-tier content may be used to improve Google products and read by human reviewers.
# The app never sends resume/KB content to Gemini and blocks it in live modes.
GEMINI_API_KEY=
# TODO(verify): set from official Gemini docs at the start of Phase 4
GEMINI_ANSWER_MODEL=
# Must be true to use ANSWER_PROVIDER=gemini. Acknowledges the free-tier data terms AND that
# you are not serving end users in the EEA, Switzerland, or the UK (free tier not allowed there).
GEMINI_FREE_TIER_DATA_ACK=false

# --- Spending, quota, and safety limits ---
# Max answer requests per session (Phase 4)
MAX_ANSWERS_PER_SESSION=100
# Max transcription minutes per session
MAX_TRANSCRIPTION_MINUTES=90
# Daily spend ceiling in USD for future paid providers (none exist; spend is always $0).
# Provider budget alerts are NOT hard caps.
DAILY_SPEND_LIMIT_USD=0
# Fraction of each provider's PUBLISHED free-tier limits the app allows itself to use,
# counted over rolling minute/hour/24-hour windows
FREE_QUOTA_SAFETY_RATIO=0.8
# Free-tier usage (requests, audio seconds) per minute for 24 h; gitignored
SPEND_LEDGER_PATH=./data/usage-ledger.json
